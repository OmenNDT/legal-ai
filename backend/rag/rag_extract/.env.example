# RAG Extract Configuration (tích hợp từ BTMH)
# Copy các biến này vào .env chính của legal-ai

# ── API Key Auth ──
# Bắt buộc cho production. Nếu không set, sẽ tự sinh key ngẫu nhiên (chỉ dev)
RAG_API_KEY=your-rag-api-key-here
RAG_ADMIN_API_KEY=your-rag-admin-key-here

# ── Vector Store ──
# chromadb = file-based (default, dev)
# postgres = PostgreSQL + pgvector (production)
VECTOR_STORE_TYPE=chromadb

# ChromaDB (khi VECTOR_STORE_TYPE=chromadb)
CHROMA_DIR=./backend/rag_extract/data/chroma
CHROMA_COLLECTION=rag_documents_v2

# PostgreSQL + pgvector (khi VECTOR_STORE_TYPE=postgres)
# POSTGRES_URL=postgresql://user:pass@localhost:5432/rag_db
# POSTGRES_VECTOR_DIMS=4096

# ── Ollama Embedding ──
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b

# ── LightRAG (optional) ──
LIGHTRAG_DIR=./backend/rag_extract/data/lightrag
LIGHTRAG_LLM_MODEL=claude-haiku-4-5-20251001

# ── Data Paths ──
RAG_DATA_DIR=./backend/rag_extract/data
RAG_UPLOAD_DIR=./backend/rag_extract/data/uploads
